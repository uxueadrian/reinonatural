---
import { experiences } from '../../data/site';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
---

<section id="experiencias" class="border-b border-sand-200">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div data-animate="fade-up" class="mx-auto max-w-2xl space-y-4 text-center">
      <h2 class="text-3xl font-bold text-forest-900 sm:text-4xl">Experiencias</h2>
      <p class="text-sand-800">
        [TODO: client-approved intro about experiences and dynamics offered]
      </p>
    </div>

    <div class="mt-12 space-y-12 md:space-y-16">
      {
        experiences.map((experience, index) => {
          const flip = index % 2 === 1;
          return (
            <article
              data-animate="fade-up"
              class="grid items-center gap-6 md:grid-cols-2 md:gap-10"
            >
              <PhotoPlaceholder class={flip ? 'md:order-2' : ''} />
              <div class:list={['space-y-2', flip && 'md:order-1']}>
                <h3 class="text-2xl font-semibold text-forest-800">
                  {experience.title}
                </h3>
                <p class="font-medium text-clay-700">{experience.place}</p>
                <p class="text-sand-800">{experience.description}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

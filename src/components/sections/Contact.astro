---
import WhatsAppLink from '../WhatsAppLink.astro';
---

<section id="contacto" class="border-b border-sand-200">
  <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 md:py-24">
    <div data-animate="fade-up" class="space-y-4">
      <h2 class="text-3xl font-bold text-forest-900 sm:text-4xl">Contacto</h2>
      <p class="text-sand-800">
        [TODO: client-approved intro for the contact section]
      </p>
      <p class="text-sm text-sand-600">
        El contacto se realiza únicamente por WhatsApp. No es un sistema de
        reservaciones ni de pagos.
      </p>
    </div>

    <div data-animate="fade-up" class="mt-8 flex justify-center">
      <WhatsAppLink class="px-8 py-4 text-base">Escribir por WhatsApp</WhatsAppLink>
    </div>

    <p data-animate="fade-up" class="mt-4 text-xs text-sand-600">
      [TODO: client-approved contact note]
    </p>
  </div>
</section>

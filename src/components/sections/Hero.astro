---
import { site } from '../../data/site';
import WhatsAppLink from '../WhatsAppLink.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
---

<section id="inicio" class="scroll-mt-20 border-b border-sand-200 bg-sand-100">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div data-animate="fade-up" class="space-y-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-forest-600">
        {site.name}
      </p>
      <h1 class="text-4xl font-bold leading-tight text-forest-900 sm:text-5xl">
        {site.tagline}
      </h1>
      <p class="text-lg text-sand-800">{site.intro}</p>
      <div class="flex flex-wrap gap-4">
        <a
          href="#destinos"
          class="inline-flex items-center justify-center rounded-lg bg-clay-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-clay-700"
        >
          Ver destinos
        </a>
        <WhatsAppLink>Escribir por WhatsApp</WhatsAppLink>
      </div>
      <p class="text-xs text-sand-600">[TODO: client-approved hero copy and photo]</p>
    </div>

    <PhotoPlaceholder label="[TODO: main hero photo provided by the client]" class="w-full" />
  </div>
</section>

---
import { trackRecord } from '../../data/site';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
---

<section id="trayectoria" class="border-b border-sand-200">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div data-animate="fade-up" class="mx-auto max-w-2xl space-y-4 text-center">
      <h2 class="text-3xl font-bold text-forest-900 sm:text-4xl">Trayectoria</h2>
      <p class="text-sand-800">
        [TODO: client-approved intro about mountains, destinations and places
        already visited by the agency]
      </p>
    </div>

    <div class="mt-12 space-y-12 md:space-y-16">
      {
        trackRecord.map((place) => (
          <article
            data-animate="fade-up"
            class="grid items-center gap-6 md:grid-cols-2 md:gap-10"
          >
            <PhotoPlaceholder />
            <div class="space-y-3">
              <h3 class="text-2xl font-semibold text-forest-800">{place.name}</h3>
              <p class="text-sand-800">{place.description}</p>
              <p class="text-sm text-sand-600">{place.note}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import { values } from '../../data/site';
---

<section id="nosotros" class="border-b border-sand-200">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div data-animate="fade-up" class="mx-auto max-w-2xl space-y-4 text-center">
      <h2 class="text-3xl font-bold text-forest-900 sm:text-4xl">Nosotros</h2>
      <p class="text-sand-800">
        [TODO: client-approved description of the agency — purpose, philosophy
        and way of working]
      </p>
    </div>

    <div class="mt-12 border-t border-sand-200">
      {
        values.map((value) => (
          <article
            data-animate="fade-up"
            class="grid gap-2 border-b border-sand-200 py-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-10"
          >
            <h3 class="text-xl font-semibold text-forest-800">{value.title}</h3>
            <p class="text-sand-800">{value.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
